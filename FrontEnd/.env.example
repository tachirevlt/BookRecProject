# Biến môi trường cho Frontend (Vite)
# Sao chép file này thành `.env.local` và điền giá trị thực tế
# Lưu ý: Tất cả biến môi trường Vite phải có tiền tố VITE_

# ─── API ────────────────────────────────────────────────────────────────────
# URL gốc của Backend API (không có dấu / ở cuối)
VITE_API_BASE_URL=https://localhost:5227

# ─── APP ─────────────────────────────────────────────────────────────────────
# Tên ứng dụng hiển thị
VITE_APP_NAME=BookRec

# Môi trường chạy: development | staging | production
VITE_APP_ENV=development
